pid @@RUN_ROOT@@/nginx.pid;
error_log @@LOG_ROOT@@/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log @@LOG_ROOT@@/nginx-access.log;
    sendfile on;
    keepalive_timeout 30;
    server_tokens off;

    server {
        listen 127.0.0.1:5173;
        server_name localhost;
        root @@CURRENT_ROOT@@/frontend/dist;
        index index.html;
        client_max_body_size @@MAX_UPLOAD_BYTES@@;

        location ^~ /api/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Range $http_range;
            proxy_set_header If-Range $http_if_range;
            proxy_request_buffering off;
            proxy_buffering off;
            add_header Cache-Control "no-store" always;
        }

        location ~* \.(?:js|css|map|png|jpg|jpeg|gif|svg|ico|woff|woff2)$ {
            try_files $uri =404;
            expires 1h;
            add_header Cache-Control "public, max-age=3600";
        }

        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache";
        }

        location ~ /\. {
            deny all;
        }
    }
}
