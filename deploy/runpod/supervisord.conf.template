[unix_http_server]
file=@@SUPERVISOR_SOCKET@@
chmod=0600

[supervisord]
logfile=@@LOG_ROOT@@/supervisord.log
logfile_maxbytes=20MB
logfile_backups=5
pidfile=@@RUN_ROOT@@/supervisord.pid
childlogdir=@@LOG_ROOT@@
nodaemon=false
minfds=1024
minprocs=200
umask=027

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@@SUPERVISOR_SOCKET@@

[program:video-factory-postgres]
command=@@POSTGRES_BIN@@ -D @@POSTGRES_DATA@@ -c listen_addresses=127.0.0.1 -c port=@@POSTGRES_PORT@@ -c unix_socket_directories=@@POSTGRES_SOCKET_DIR@@ -c unix_socket_permissions=0700 -c password_encryption=scram-sha-256
directory=@@STATE_ROOT@@
user=postgres
priority=10
autostart=false
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=60
stopasgroup=true
killasgroup=true
stdout_logfile=@@LOG_ROOT@@/postgres.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:video-factory-api]
command=@@CURRENT_ROOT@@/.venv/bin/video-app-api --env-file @@ENV_FILE@@ --host 127.0.0.1 --port 8000
directory=@@CURRENT_ROOT@@
priority=20
numprocs=1
autostart=false
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=30
stopasgroup=true
killasgroup=true
stdout_logfile=@@LOG_ROOT@@/api.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:video-factory-worker]
command=@@CURRENT_ROOT@@/.venv/bin/video-app-worker --env-file @@ENV_FILE@@
directory=@@CURRENT_ROOT@@
priority=30
numprocs=1
autostart=false
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=120
stopasgroup=true
killasgroup=true
stdout_logfile=@@LOG_ROOT@@/worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:video-factory-nginx]
command=/usr/sbin/nginx -c @@NGINX_CONFIG@@ -p @@INSTALL_ROOT@@/nginx -g "daemon off;"
directory=@@CURRENT_ROOT@@
priority=40
numprocs=1
autostart=false
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=QUIT
stopwaitsecs=30
stopasgroup=true
killasgroup=true
stdout_logfile=@@LOG_ROOT@@/nginx-supervisor.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:video-factory-tailscaled]
command=/usr/sbin/tailscaled --tun=userspace-networking --statedir=@@TAILSCALE_STATE@@ --socket=@@TAILSCALE_SOCKET@@ --config=@@TAILSCALE_CONFIG@@
directory=@@STATE_ROOT@@
priority=50
numprocs=1
autostart=false
autorestart=unexpected
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=30
stopasgroup=true
killasgroup=true
stdout_logfile=@@LOG_ROOT@@/tailscaled.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true
