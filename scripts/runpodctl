#!/usr/bin/env bash
set -Eeuo pipefail

readonly managed_script="/opt/video-factory/current/deploy/runpod/runpod_deploy.py"
readonly checkout_script="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/deploy/runpod/runpod_deploy.py"

if [[ -f "${managed_script}" ]]; then
  exec /usr/bin/python3 "${managed_script}" "$@"
fi
if [[ -f "${checkout_script}" ]]; then
  exec /usr/bin/python3 "${checkout_script}" "$@"
fi

printf 'ERROR: no Video Factory deployment manager was found. Run the approved bootstrap first.\n' >&2
exit 3
