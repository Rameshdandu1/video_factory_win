# Local development only. Copy this file to .env before starting PostgreSQL.
POSTGRES_USER=video_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=video_factory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://video_app:change-this-local-password@127.0.0.1:5432/video_factory

# Application runtime. DATA_ROOT must be absolute and outside the source tree.
VIDEO_APP_DATA_ROOT=C:/video-generation-data
VIDEO_APP_CURSOR_SECRET=replace-with-at-least-32-random-characters
VIDEO_APP_QUEUE_CAPACITY=10
VIDEO_APP_BACKEND=fake
VIDEO_APP_MODEL_ID=wan21-t2v
VIDEO_APP_MODEL_DISPLAY_NAME=Wan2.1 Text to Video
VIDEO_APP_MODEL_RESOLUTIONS=832x480
VIDEO_APP_MODEL_FRAME_COUNTS=81
VIDEO_APP_LEASE_SECONDS=60
VIDEO_APP_HEARTBEAT_SECONDS=10
VIDEO_APP_POLL_SECONDS=2

# Pinned external Wan2.1 worker. Keep these commented while VIDEO_APP_BACKEND=fake.
# To enable it, change VIDEO_APP_BACKEND above to wan21 and configure all five values.
# Runtime dependencies and checkpoint files live outside this repository.
#
# T2V-1.3B supports 832x480 and 480x832 with frame count 81:
# VIDEO_APP_WAN21_REPOSITORY_ROOT=C:/path/to/Wan2.1
# VIDEO_APP_WAN21_CHECKPOINT_DIR=C:/path/to/Wan2.1-T2V-1.3B
# VIDEO_APP_WAN21_PYTHON=C:/path/to/wan21-venv/Scripts/python.exe
# VIDEO_APP_WAN21_TASK=t2v-1.3B
# VIDEO_APP_WAN21_MODEL_REVISION=37ec512624d61f7aa208f7ea8140a131f93afc9a
#
# T2V-14B supports 832x480, 480x832, 1280x720, and 720x1280 with frame count 81.
# A complete T2V-14B alternative is:
# VIDEO_APP_MODEL_RESOLUTIONS=832x480,480x832,1280x720,720x1280
# VIDEO_APP_MODEL_FRAME_COUNTS=81
# VIDEO_APP_WAN21_REPOSITORY_ROOT=C:/path/to/Wan2.1
# VIDEO_APP_WAN21_CHECKPOINT_DIR=C:/path/to/Wan2.1-T2V-14B
# VIDEO_APP_WAN21_PYTHON=C:/path/to/wan21-venv/Scripts/python.exe
# VIDEO_APP_WAN21_TASK=t2v-14B
# VIDEO_APP_WAN21_MODEL_REVISION=a064a6c71f5be440641209c07bf2a5ce7a2ff5e4
#
# Both tasks require the Wan2.1 checkout at commit:
# 9737cba9c1c3c4d04b33fcad41c111989865d315
