# Local development only. Copy this file to .env before starting PostgreSQL.
POSTGRES_USER=video_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=video_factory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://video_app:change-this-local-password@127.0.0.1:5432/video_factory

# Application runtime. DATA_ROOT must be absolute and outside the source tree.
VIDEO_APP_DATA_ROOT=C:/video-generation-data
VIDEO_APP_CURSOR_SECRET=replace-with-at-least-32-random-characters
VIDEO_APP_QUEUE_CAPACITY=10
VIDEO_APP_BACKEND=fake
VIDEO_APP_MODEL_ID=wan21-t2v
VIDEO_APP_MODEL_DISPLAY_NAME=Wan2.1 Text to Video
VIDEO_APP_MODEL_RESOLUTIONS=832x480
VIDEO_APP_MODEL_FRAME_COUNTS=81
VIDEO_APP_LEASE_SECONDS=60
VIDEO_APP_HEARTBEAT_SECONDS=10
VIDEO_APP_POLL_SECONDS=2
