# Local development only. Copy this file to .env before starting PostgreSQL.
# RunPod does not copy or source this example. Its installer atomically generates a separate
# /etc/video-factory/video-factory.env using this application's literal KEY=VALUE parser.
POSTGRES_USER=video_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=video_factory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://video_app:change-this-local-password@127.0.0.1:5432/video_factory

# Application runtime. DATA_ROOT must be absolute and outside the source tree.
VIDEO_APP_DATA_ROOT=C:/video-generation-data
VIDEO_APP_CURSOR_SECRET=replace-with-at-least-32-random-characters
VIDEO_APP_QUEUE_CAPACITY=10
VIDEO_APP_BACKEND=fake
VIDEO_APP_OWNER_ID=local-owner
VIDEO_APP_MAX_UPLOAD_BYTES=52428800

# Optional pinned ffprobe media inspection. Configure all three pin values together.
# Record the exact first line from `ffprobe -version` and the executable SHA-256.
# VIDEO_APP_FFPROBE_EXECUTABLE=C:/path/to/verified/ffprobe.exe
# VIDEO_APP_FFPROBE_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_FFPROBE_VERSION_LINE=ffprobe version replace-with-exact-first-line
# VIDEO_APP_FFPROBE_TIMEOUT_SECONDS=30
# VIDEO_APP_FFPROBE_MAX_OUTPUT_BYTES=2097152

# Optional approved storyboard + recorded-dialogue rough-cut renderer. Keep disabled until the
# report proves the exact FFmpeg/ffprobe pins, measured output, hash enforcement, and cancellation
# cleanup. Set VIDEO_APP_BACKEND=ffmpeg-rough-cut only in its dedicated worker environment.
# VIDEO_APP_ROUGH_CUT_ENABLED=true
# VIDEO_APP_ROUGH_CUT_QUALIFICATION_REPORT=C:/video-generation-data/qualification/rough-cut.json
# VIDEO_APP_ROUGH_CUT_FFMPEG_EXECUTABLE=C:/path/to/verified/ffmpeg.exe
# VIDEO_APP_ROUGH_CUT_FFMPEG_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_ROUGH_CUT_FFMPEG_VERSION_LINE=ffmpeg version replace-with-exact-first-line
# VIDEO_APP_ROUGH_CUT_WIDTH=1280
# VIDEO_APP_ROUGH_CUT_HEIGHT=720
# VIDEO_APP_ROUGH_CUT_FPS_NUMERATOR=24
# VIDEO_APP_ROUGH_CUT_FPS_DENOMINATOR=1
# VIDEO_APP_ROUGH_CUT_DEADLINE_SECONDS=7200
# Qualification harness only; use operator-approved local fixture media and an external report dir.
# VIDEO_APP_RUN_ROUGH_CUT_QUALIFICATION=1
# VIDEO_APP_ROUGH_CUT_QUALIFICATION_IMAGE=C:/approved-fixtures/storyboard.png
# VIDEO_APP_ROUGH_CUT_QUALIFICATION_AUDIO=C:/approved-fixtures/dialogue.wav
# VIDEO_APP_ROUGH_CUT_QUALIFICATION_DIR=C:/video-generation-data/qualification

# Optional approved final-timeline renderer. Keep disabled until an operator-reviewed report
# matches the exact FFmpeg/ffprobe/font hashes and proves Telugu glyphs, title/caption rendering,
# explicit audio mixing, measured output, input-hash rejection, and cancellation cleanup.
# Use VIDEO_APP_BACKEND=ffmpeg-timeline-render only in its dedicated worker environment.
# VIDEO_APP_TIMELINE_RENDER_ENABLED=true
# VIDEO_APP_TIMELINE_RENDER_QUALIFICATION_REPORT=C:/video-generation-data/qualification/timeline-render.json
# VIDEO_APP_TIMELINE_RENDER_FFMPEG_EXECUTABLE=C:/path/to/verified/ffmpeg.exe
# VIDEO_APP_TIMELINE_RENDER_FFMPEG_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_TIMELINE_RENDER_FFMPEG_VERSION_LINE=ffmpeg version replace-with-exact-first-line
# VIDEO_APP_TIMELINE_RENDER_FONT_FILE=C:/path/to/verified/NotoSansTelugu-Regular.ttf
# VIDEO_APP_TIMELINE_RENDER_FONT_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_TIMELINE_RENDER_FONT_FAMILY=Noto Sans Telugu
# VIDEO_APP_TIMELINE_RENDER_WIDTH=1280
# VIDEO_APP_TIMELINE_RENDER_HEIGHT=720
# VIDEO_APP_TIMELINE_RENDER_FPS_NUMERATOR=24
# VIDEO_APP_TIMELINE_RENDER_FPS_DENOMINATOR=1
# VIDEO_APP_TIMELINE_RENDER_DURATION_MS=900000
# VIDEO_APP_TIMELINE_RENDER_DEADLINE_SECONDS=14400
# Qualification harness writes a pending review draft and MP4. An operator must inspect Telugu
# glyphs, titles/captions, and the audio mix before changing every review field to true and status
# to approved in the configured qualification report.
# VIDEO_APP_RUN_TIMELINE_RENDER_QUALIFICATION=1
# VIDEO_APP_TIMELINE_RENDER_QUALIFICATION_AUDIO=C:/approved-fixtures/full-duration-mix.wav
# VIDEO_APP_TIMELINE_RENDER_QUALIFICATION_DIR=C:/video-generation-data/qualification
VIDEO_APP_MODEL_ID=wan21-t2v
VIDEO_APP_MODEL_DISPLAY_NAME=Wan2.1 Text to Video
VIDEO_APP_MODEL_RESOLUTIONS=832x480
VIDEO_APP_MODEL_FRAME_COUNTS=81
VIDEO_APP_LEASE_SECONDS=60
VIDEO_APP_HEARTBEAT_SECONDS=10
VIDEO_APP_POLL_SECONDS=2

# Pinned external Wan2.1 worker. Keep these commented while VIDEO_APP_BACKEND=fake.
# To enable it, change VIDEO_APP_BACKEND above to wan21 and configure all five values.
# Runtime dependencies and checkpoint files live outside this repository.
#
# T2V-1.3B supports 832x480 and 480x832 with frame count 81:
# VIDEO_APP_WAN21_REPOSITORY_ROOT=C:/path/to/Wan2.1
# VIDEO_APP_WAN21_CHECKPOINT_DIR=C:/path/to/Wan2.1-T2V-1.3B
# VIDEO_APP_WAN21_PYTHON=C:/path/to/wan21-venv/Scripts/python.exe
# VIDEO_APP_WAN21_TASK=t2v-1.3B
# VIDEO_APP_WAN21_MODEL_REVISION=37ec512624d61f7aa208f7ea8140a131f93afc9a
#
# T2V-14B supports 832x480, 480x832, 1280x720, and 720x1280 with frame count 81.
# A complete T2V-14B alternative is:
# VIDEO_APP_MODEL_RESOLUTIONS=832x480,480x832,1280x720,720x1280
# VIDEO_APP_MODEL_FRAME_COUNTS=81
# VIDEO_APP_WAN21_REPOSITORY_ROOT=C:/path/to/Wan2.1
# VIDEO_APP_WAN21_CHECKPOINT_DIR=C:/path/to/Wan2.1-T2V-14B
# VIDEO_APP_WAN21_PYTHON=C:/path/to/wan21-venv/Scripts/python.exe
# VIDEO_APP_WAN21_TASK=t2v-14B
# VIDEO_APP_WAN21_MODEL_REVISION=a064a6c71f5be440641209c07bf2a5ce7a2ff5e4
#
# Both tasks require the Wan2.1 checkout at commit:
# 9737cba9c1c3c4d04b33fcad41c111989865d315

# Optional qualified Wan2.2 TI2V provider. It can be discovered by the API while the quick worker
# remains fake/wan21. Set VIDEO_APP_BACKEND=wan22 only in the dedicated I2V worker environment.
# VIDEO_APP_WAN22_TI2V_ENABLED=true
# VIDEO_APP_WAN22_REPOSITORY_ROOT=C:/path/to/Wan2.2
# VIDEO_APP_WAN22_CHECKPOINT_DIR=C:/path/to/Wan2.2-TI2V-5B
# VIDEO_APP_WAN22_PYTHON=C:/path/to/wan22-venv/Scripts/python.exe
# VIDEO_APP_WAN22_QUALIFICATION_REPORT=C:/video-generation-data/qualification/wan22-ti2v-qualification.json
# VIDEO_APP_WAN22_CHECKPOINT_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_WAN22_DEADLINE_SECONDS=7200
# Code pin: 1ea34ff48f87168174e12956e200b1d908b1c5ff
# Model pin: 921dbaf3f1674a56f47e83fb80a34bac8a8f203e

# Optional controlled-video providers. Both are disabled until a target-GPU qualification report
# proves the exact code/model/checkpoint/FFmpeg pins and both input roles. Configure the three shared
# FFmpeg values together before enabling either provider.
# VIDEO_APP_CONTROLLED_FFMPEG_EXECUTABLE=C:/path/to/verified/ffmpeg.exe
# VIDEO_APP_CONTROLLED_FFMPEG_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_CONTROLLED_FFMPEG_VERSION_LINE=ffmpeg version replace-with-exact-first-line
#
# VACE performance transfer. Code pin: 48eb44f1c4be87cc65a98bff985a26976841e9f3
# Model pin: c76cda849bfb74d563b95f3db039421e9df2a570
# VIDEO_APP_VACE_ENABLED=true
# VIDEO_APP_VACE_REPOSITORY_ROOT=C:/path/to/VACE
# VIDEO_APP_VACE_CHECKPOINT_DIR=C:/path/to/VACE-Wan2.1-1.3B-Preview
# VIDEO_APP_VACE_PYTHON=C:/path/to/vace-venv/Scripts/python.exe
# VIDEO_APP_VACE_QUALIFICATION_REPORT=C:/video-generation-data/qualification/vace.json
# VIDEO_APP_VACE_CHECKPOINT_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_VACE_DEADLINE_SECONDS=7200
#
# Wan2.2-Animate character animation/replacement.
# Code pin: 29d4a35d32273d5309a3a95250bd4e118d8789b2
# Model pin: cb93a225fbaf1ca100f54e79da8f994995b689b3
# VIDEO_APP_WAN_ANIMATE_ENABLED=true
# VIDEO_APP_WAN_ANIMATE_REPOSITORY_ROOT=C:/path/to/Wan2.2
# VIDEO_APP_WAN_ANIMATE_CHECKPOINT_DIR=C:/path/to/Wan2.2-Animate-14B
# VIDEO_APP_WAN_ANIMATE_PYTHON=C:/path/to/animate-venv/Scripts/python.exe
# VIDEO_APP_WAN_ANIMATE_QUALIFICATION_REPORT=C:/video-generation-data/qualification/animate.json
# VIDEO_APP_WAN_ANIMATE_CHECKPOINT_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters
# VIDEO_APP_WAN_ANIMATE_DEADLINE_SECONDS=7200
#
# Operator-only controlled GPU qualification inputs. Run once with provider=vace and once with
# provider=animate; do not commit authorized media or generated reports.
# VIDEO_APP_CONTROLLED_QUALIFICATION_PROVIDER=vace
# VIDEO_APP_CONTROLLED_QUALIFICATION_IMAGE=C:/path/to/authorized-reference.png
# VIDEO_APP_CONTROLLED_QUALIFICATION_VIDEO=C:/path/to/authorized-driving-video.mp4
# VIDEO_APP_CONTROLLED_QUALIFICATION_DIR=C:/video-generation-data/qualification
# VIDEO_APP_CONTROLLED_QUALIFICATION_TRIM_END_MS=2000
# VIDEO_APP_CONTROLLED_MINIMUM_FREE_DISK_BYTES=107374182400
# VIDEO_APP_CONTROLLED_MINIMUM_FREE_VRAM_BYTES=25769803776
# VIDEO_APP_CONTROLLED_CANCEL_AFTER_SECONDS=5
